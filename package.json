    "@typescript-eslint/parser": "8.34.1",
    "eslint": "9.25.1",
    "eslint-config-next": "16.2.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
