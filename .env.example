# ==============================================================================
# پیکربندی متمرکز پروژه ۶دقیقه (6min Central Environment Configuration)
# ==============================================================================

# ------------------------------------------------------------------------------
# تنظیمات سرویس ربات تلگرام (Telegram Admin OTP Service)
# ------------------------------------------------------------------------------

# توکن اختصاصی ربات تلگرام دریافتی از @BotFather
# نمونه: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# شناسه عددی چت ادمین (Chat ID) برای ارسال کدهای ورود
# پس از ران کردن ربات، با ارسال دستور /start به ربات، این آیدی برای شما ارسال می‌شود
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here

# کلید امنیتی برای ارتباط امن داخلی با وب‌سرویس پیامکی (ارسال در هدر X-API-Key)
TELEGRAM_SERVICE_API_KEY=sixmin_secret_otp_token_change_me

# هاست و پورت وب‌سرویس پیامکی پایتون
TELEGRAM_SERVICE_HOST=127.0.0.1
TELEGRAM_SERVICE_PORT=8000

# تنظیمات پراکسی (در صورت نیاز به عبور از فیلترینگ تلگرام در لوکال یا سرور ایران)
# نمونه‌ها: socks5://127.0.0.1:10808 یا http://127.0.0.1:10809 (در صورت عدم نیاز خالی بگذارید)
TELEGRAM_PROXY_URL=

# تنظیمات کد یکبار مصرف OTP
OTP_EXPIRE_MINUTES=2
OTP_COOLDOWN_SECONDS=60
